# Server rules for Apache hosts (cPanel and most shared hosting). Other servers ignore this file:
# see docs/DEPLOYMENT-RUNBOOK.md for the Nginx and Netlify equivalents.

# 1. Use HTTPS and the bare domain. Applies only on the real domain, so testing on a temporary
#    address (server IP, host preview URL) is not redirected.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Certificate authorities check /.well-known/ over plain HTTP; never redirect those requests.
    RewriteCond %{REQUEST_URI} !^/\.well-known/(acme-challenge|pki-validation)/
    RewriteCond %{HTTP_HOST} ^(www\.)?jaboassociates\.business$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://jaboassociates.business%{REQUEST_URI} [L,R=301]

    RewriteCond %{REQUEST_URI} !^/\.well-known/(acme-challenge|pki-validation)/
    RewriteCond %{HTTP_HOST} ^www\.jaboassociates\.business$ [NC]
    RewriteRule ^ https://jaboassociates.business%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. Branded not-found page
ErrorDocument 404 /404.html

# 3. No folder listings; hide dotfiles such as .htaccess (but not /.well-known/, used for certificates)
Options -Indexes
<FilesMatch "^\.(?!well-known$)">
    Require all denied
</FilesMatch>

# 4. Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Turn this on only after HTTPS works everywhere on the domain (browsers remember it):
    # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# 5. File types
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
</IfModule>

# 6. Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/plain
</IfModule>

# 7. Browser caching (images keep their names, so give a replaced image a new name)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
